<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2015/06/nuspec.xsd">
  <metadata>
    <id>mole</id>
    <version>{{VERSION}}</version>
    <title>Mole</title>
    <authors>tw93</authors>
    <owners>tw93</owners>
    <summary>Deep clean, uninstall apps, optimize, analyze disk, and monitor Windows from the terminal.</summary>
    <description>Mole is a free, open-source command-line toolkit for Windows maintenance. It cleans caches and temporary files, removes apps together with their leftovers, runs bounded maintenance tasks, explores disk usage, and shows live system status. Every destructive command can be previewed with --dry-run.

Run `mo` for the interactive menu, or `mo clean --dry-run` to preview a cleanup.</description>
    <projectUrl>https://github.com/tw93/Mole/tree/windows</projectUrl>
    <projectSourceUrl>https://github.com/tw93/Mole/tree/windows</projectSourceUrl>
    <packageSourceUrl>https://github.com/tw93/Mole/tree/windows/packaging/chocolatey</packageSourceUrl>
    <docsUrl>https://github.com/tw93/Mole/blob/windows/README.md</docsUrl>
    <bugTrackerUrl>https://github.com/tw93/Mole/issues</bugTrackerUrl>
    <licenseUrl>https://github.com/tw93/Mole/blob/windows/LICENSE</licenseUrl>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <releaseNotes>https://github.com/tw93/Mole/releases/tag/{{TAG}}</releaseNotes>
    <tags>mole cleanup cache disk-space uninstaller maintenance cli foss</tags>
  </metadata>
  <files>
    <file src="tools\**" target="tools" />
  </files>
</package>
