{
    "version": "{{VERSION}}",
    "description": "Deep clean, uninstall apps, optimize, analyze disk, and monitor Windows from the terminal.",
    "homepage": "https://github.com/tw93/Mole/tree/windows",
    "license": "GPL-3.0",
    "url": "{{ZIP_URL}}",
    "hash": "{{ZIP_SHA256}}",
    "bin": [
        "mo.exe",
        [
            "mo.exe",
            "mole"
        ]
    ],
    "checkver": {
        "url": "https://github.com/tw93/Mole/releases",
        "regex": "/releases/tag/V([\\d.]+)-windows"
    },
    "autoupdate": {
        "url": "https://github.com/tw93/Mole/releases/download/V$version-windows/mole-$version-x64.zip",
        "hash": {
            "url": "$baseurl/SHA256SUMS.txt"
        }
    }
}
